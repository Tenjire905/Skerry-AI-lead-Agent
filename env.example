# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3001

# Required: min 32 chars. Used to sign session cookies.
SESSION_SECRET=

# Demo accounts (solo@skerry.io / solo123, etc.). Never enable in production.
ALLOW_DEMO_AUTH=true

# Comma-separated browser origins allowed to call the API with credentials.
# Required when NODE_ENV=production.
# SKERRY_ALLOWED_ORIGINS=https://your-app.example.com

# Postgres for monthly run entitlements (optional locally; required for real usage limits).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Production: TLS to server; set DATABASE_SSL_REJECT_UNAUTHORIZED=false only if your provider needs it.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

RESEND_API_KEY=
NEVERBOUNCE_API_KEY=
APIFY_API_KEY=

SKERRY_FROM_EMAIL=Skerry <onboarding@resend.dev>

PROVIDER_TIMEOUT_MS=12000
PROVIDER_RETRIES=2

# Client dev: point SPA at API (Vite). Leave unset in production (same origin).
# VITE_API_BASE=http://localhost:3001

# --- Backups (scripts/backup.sh + .github/workflows/backup.yml) ---
# These are CI-only secrets; do NOT put them in the app server's env.
# BACKUP_DATABASE_URL=postgres://readonly_backup_user:...@host/dbname
# BACKUP_BUCKET=s3://skerry-backups/prod
# BACKUP_ENCRYPTION_KEY=                         # >=32 chars
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_AWS_REGION=eu-central-1                 # 'auto' for Cloudflare R2
# BACKUP_AWS_ENDPOINT_URL_S3=                    # set for R2: https://<account>.r2.cloudflarestorage.com
# BACKUP_RETENTION_DAYS=30
# OPS_SLACK_WEBHOOK_URL=                         # optional, alerts on backup failure
